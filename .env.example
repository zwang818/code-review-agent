# 复制为 .env 后填写。密钥不要提交到仓库。
OPENAI_API_KEY=your-api-key
# 这是 API 前缀，程序会追加 /chat/completions，不要填写聊天网页地址。
OPENAI_BASE_URL=https://api.openai.com/v1
# 替换为你账号中可用、支持 Chat Completions tools 的模型 ID。
OPENAI_MODEL=your-tool-capable-model

AGENT_TIMEOUT=30
AGENT_MAX_RETRIES=2
AGENT_MAX_ROUNDS=10
AGENT_MAX_TOOL_CALLS=24
AGENT_MEMORY_TURNS=4
AGENT_MAX_CONTEXT_CHARS=100000
